PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# --- Database --------------------------------------------------------------
DATABASE_URL=postgresql://shiftsync:shiftsync@localhost:5436/shiftsync
DIRECT_URL=postgresql://shiftsync:shiftsync@localhost:5436/shiftsync

# --- Identity --------------------------------------------------------------
# Leave the Supabase values blank to run the self-hosted identity provider:
# credentials live in this application's own database and are created by the
# seed. Fill them in to use Supabase instead. Nothing else changes.
#
# Force a provider regardless of credentials with: local | supabase
AUTH_PROVIDER=

SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Signing secret for self-hosted tokens. Without it a random one is generated
# at boot, which invalidates every token on restart.
LOCAL_AUTH_SECRET=dev-only-change-me-in-any-real-deployment

# Password given to every seeded account.
SEED_PASSWORD=CoastalEats!2026
